OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Gemini key for the ADK agent (`adk web agents` / `adk run`)
GOOGLE_API_KEY=

# Leave DATABASE_URL empty to use the pip-installable embedded Postgres + pgvector.
# For Docker: postgresql+psycopg://sec:sec@localhost:5432/sec_filings
DATABASE_URL=
PGDATA_DIR=.pgdata
EMBEDDED_DB_NAME=sec_filings

SEC_USER_AGENT=sec-filings-genAi-api your-email@example.com

EMBEDDING_PROVIDER=openai
LLM_PROVIDER=openai
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RAG_TOP_K=8
INGEST_DEFAULT_LIMIT=3

SECRET_KEY=change-me
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000
