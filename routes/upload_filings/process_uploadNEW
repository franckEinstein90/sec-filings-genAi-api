# Security configuration
MAX_FILE_SIZE = 50 * 1024 * 1024  # 50MB
ALLOWED_EXTENSIONS = {'.pdf', '.txt', '.docx', '.doc', '.rtf', '.md'}
ALLOWED_MIME_TYPES = {
    'application/pdf',
    'text/plain',
    'text/markdown',
    'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
    'application/msword',
    'application/rtf'
}
UPLOAD_FOLDER = os.environ.get('SECURE_UPLOAD_FOLDER', 'secure_uploads')
QUARANTINE_FOLDER = os.path.join(UPLOAD_FOLDER, 'quarantine')

def create_upload_directories():
    """Ensure upload directories exist with proper permissions."""
    try:
        Path(UPLOAD_FOLDER).mkdir(parents=True, exist_ok=True, mode=0o750)
        Path(QUARANTINE_FOLDER).mkdir(parents=True, exist_ok=True, mode=0o750)
        logger.info("Upload directories created successfully")
    except Exception as e:
        logger.error(f"Failed to create upload directories: {e}")
        raise

def validate_file_security(file: FileStorage) -> dict:
    """
    Comprehensive file security validation.
    Returns dict with validation results and any errors.
    """
    validation_result = {
        'valid': True,
        'errors': [],
        'warnings': []
    }
    
    # Check if file exists
    if not file or not file.filename:
        validation_result['valid'] = False
        validation_result['errors'].append('No file provided')
        return validation_result
    
    # File size validation
    file.seek(0, 2)  # Seek to end
    file_size = file.tell()
    file.seek(0)  # Reset to beginning
    
    if file_size == 0:
        validation_result['valid'] = False
        validation_result['errors'].append('Empty file not allowed')
        return validation_result
    
    if file_size > MAX_FILE_SIZE:
        validation_result['valid'] = False
        validation_result['errors'].append(f'File size exceeds maximum allowed size of {MAX_FILE_SIZE/1024/1024}MB')
        return validation_result
    
    # File extension validation
    filename_lower = file.filename.lower()
    file_ext = Path(filename_lower).suffix
    
    if file_ext not in ALLOWED_EXTENSIONS:
        validation_result['valid'] = False
        validation_result['errors'].append(f'File extension {file_ext} not allowed. Allowed: {", ".join(ALLOWED_EXTENSIONS)}')
        return validation_result
    
    # MIME type validation
    mime_type, _ = mimetypes.guess_type(file.filename)
    if mime_type not in ALLOWED_MIME_TYPES:
        validation_result['valid'] = False
        validation_result['errors'].append(f'MIME type {mime_type} not allowed')
        return validation_result
    
    # Filename security checks
    if any(char in file.filename for char in ['..', '/', '\\', '\x00']):
        validation_result['valid'] = False
        validation_result['errors'].append('Invalid characters in filename')
        return validation_result
    
    # Check for suspicious file signatures (basic magic number validation)
    file_header = file.read(16)
    file.seek(0)  # Reset position
    
    # Basic magic number checks for common file types
    suspicious_headers = [
        b'MZ',  # PE executable
        b'\x7fELF',  # ELF executable
        b'\xd0\xcf\x11\xe0',  # OLE compound document (could be malicious)
    ]
    
    for suspicious in suspicious_headers:
        if file_header.startswith(suspicious) and file_ext not in ['.doc', '.docx']:
            validation_result['warnings'].append('File header suggests executable content')
            break
    
    return validation_result

def generate_secure_filename(original_filename: str) -> tuple[str, str]:
    """
    Generate a secure filename with hash component.
    Returns tuple of (secure_filename, filename_hash)
    """
    # Create hash of original filename with timestamp for uniqueness
    timestamp = str(int(datetime.now().timestamp()))
    filename_data = f"{original_filename}{timestamp}{secrets.token_hex(8)}"
    filename_hash = hashlib.sha256(filename_data.encode()).hexdigest()[:16]
    
    # Get file extension safely
    file_ext = Path(original_filename).suffix.lower()
    
    # Create secure filename
    base_name = secure_filename(Path(original_filename).stem)[:50]  # Limit length
    secure_name = f"{base_name}_{filename_hash}{file_ext}"
    
    return secure_name, filename_hash

def calculate_file_hash(file: FileStorage) -> str:
    """Calculate SHA-256 hash of file content."""
    hasher = hashlib.sha256()
    
    # Read file in chunks to handle large files efficiently
    file.seek(0)
    while chunk := file.read(8192):
        hasher.update(chunk)
    file.seek(0)  # Reset position
    
    return hasher.hexdigest()

def save_file_securely(file: FileStorage, secure_filename: str) -> str:
    """
    Save file to secure location with proper permissions.
    Returns the full path to saved file.
    """
    file_path = os.path.join(UPLOAD_FOLDER, secure_filename)
    
    try:
        file.save(file_path)
        # Set restrictive file permissions
        os.chmod(file_path, 0o640)
        logger.info(f"File saved securely at: {file_path}")
        return file_path
    except Exception as e:
        logger.error(f"Failed to save file securely: {e}")
        raise

def quarantine_file(file: FileStorage, reason: str) -> str:
    """Move suspicious file to quarantine folder."""
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    quarantine_filename = f"quarantined_{timestamp}_{secrets.token_hex(8)}.bin"
    quarantine_path = os.path.join(QUARANTINE_FOLDER, quarantine_filename)
    
    try:
        file.save(quarantine_path)
        os.chmod(quarantine_path, 0o600)  # Very restrictive permissions
        logger.warning(f"File quarantined at: {quarantine_path}, Reason: {reason}")
        return quarantine_path
    except Exception as e:
        logger.error(f"Failed to quarantine file: {e}")
        raise

@upload_cba_bp.route('/documents/upload', methods=['POST'])
def upload_document():
    """
    Secure document upload endpoint with comprehensive validation and error handling.
    """
    results = {
        "chunks": 0,
        "processing_steps": [],
        "security_checks": [],
        "file_path": None,
        "filename_hash": None,
        "content_hash": None
    }
    
    try:
        # Ensure upload directories exist
        create_upload_directories()
        
        # Validate API key
        openai_api_key = os.getenv("OPENAI_API_KEY")
        if not openai_api_key:
            logger.error("OpenAI API key not configured")
            return jsonify({'error': 'Server configuration error'}), 500
        
        # Get and validate file
        file = request.files.get('file')
        if not file:
            return jsonify({'error': 'No file uploaded'}), 400
        
        # Security validation
        validation = validate_file_security(file)
        results["security_checks"] = {
            'valid': validation['valid'],
            'errors': validation['errors'],
            'warnings': validation['warnings']
        }
        
        if not validation['valid']:
            # Quarantine invalid file
            try:
                quarantine_path = quarantine_file(file, f"Security validation failed: {', '.join(validation['errors'])}")
                logger.warning(f"Invalid file quarantined: {quarantine_path}")
            except Exception as qe:
                logger.error(f"Failed to quarantine file: {qe}")
            
            return jsonify({
                'error': 'File failed security validation',
                'details': validation['errors']
            }), 400
        
        # Log warnings if any
        if validation['warnings']:
            logger.warning(f"File validation warnings: {validation['warnings']}")
            results["security_checks"]['warnings'] = validation['warnings']
        
        # Parse and validate document metadata
        try:
            doc_metadata = DocumentMetadata.from_flask_request(request)
        except Exception as e:
            logger.error(f"Failed to parse document metadata: {e}")
            return jsonify({'error': 'Invalid document metadata', 'details': str(e)}), 400
        
        # Generate secure filename and hashes
        secure_fname, filename_hash = generate_secure_filename(file.filename)
#        content_hash = calculate_file_hash(file)
        
        results["filename_hash"] = filename_hash
#        results["content_hash"] = content_hash
        
        # Save file securely
        try:
            file_path = save_file_securely(file, secure_fname)
            results["file_path"] = file_path
        except Exception as e:
            logger.error(f"Failed to save file: {e}")
            return jsonify({'error': 'Failed to save file securely'}), 500
        
        # Parse vectorization parameters with validation
        vectorization_params = {}
        if request.form.get('vectorization_params'):
            try:
                vectorization_params = json.loads(request.form.get('vectorization_params'))
                if not isinstance(vectorization_params, dict):
                    raise ValueError("Vectorization parameters must be a dictionary")
            except (json.JSONDecodeError, ValueError) as e:
                logger.error(f"Invalid vectorization parameters: {e}")
                return jsonify({'error': 'Invalid vectorization parameters', 'details': str(e)}), 400
        
        # Set vectorstore name securely
        vectorstore_name = secure_filename(doc_metadata.file_name.rsplit('.', 1)[0])
        if not vectorstore_name:
            vectorstore_name = f"document_{filename_hash}"
        
        vectorization_params['vectorstore_name'] = vectorstore_name
        results["processing_steps"].append("Vectorization parameters validated")
        
        # Vectorize file with error handling
        try:
            # Reset file position before processing
            file.seek(0)
            vectorization_results = vectorize_file(file, vectorization_params, openai_api_key)
            results.update(vectorization_results)
            results["processing_steps"].append("File vectorized successfully")
        except Exception as e:
            logger.error(f"Vectorization failed: {e}")
            # Clean up saved file on vectorization failure
            try:
                if os.path.exists(file_path):
                    os.remove(file_path)
            except Exception as cleanup_e:
                logger.error(f"Failed to clean up file after vectorization error: {cleanup_e}")
            
            return jsonify({'error': 'File vectorization failed', 'details': str(e)}), 500
        
        vectorstore_path = results.get('vectorstore_path')
        if not vectorstore_path:
            logger.error("No vectorstore path returned from vectorization")
            return jsonify({'error': 'Vectorization incomplete - no vectorstore path'}), 500
        
        # Generate file description using RAG query with error handling
        try:
            file_description_response = steward_rag_query(
                query="Provide a description of what this document is and what it does in less than 200 words. Who are the parties concerned? In the description, include the period of time it covers, when it begins application and when it ends if applicable",
                vectorstore_path=vectorstore_path
            )
            
            if isinstance(file_description_response, dict) and 'content' in file_description_response:
                file_description = file_description_response['content']
            else:
                logger.warning("Unexpected response format from steward_rag_query")
                file_description = "Document processed successfully but description generation failed"
            
            results['description'] = file_description
            results["processing_steps"].append("Document description generated")
            
        except Exception as e:
            logger.error(f"Failed to generate file description: {e}")
            file_description = "Document processed successfully but description generation failed"
            results['description'] = file_description
            results["processing_steps"].append("Description generation failed - using default")
        
        # Create document entry in database with enhanced metadata
        try:
            # Add file security information to metadata
            enhanced_metadata = doc_metadata
            enhanced_metadata.content_hash = content_hash
            enhanced_metadata.filename_hash = filename_hash
            enhanced_metadata.file_path = file_path
            enhanced_metadata.upload_timestamp = datetime.now().isoformat()
            
            document_id = DocumentLibraryManager.create_document(
                document_metadata=enhanced_metadata,
                document_description=file_description,
                vectorstore_path=vectorstore_path
            )
            
            results['document_id'] = document_id
            results["processing_steps"].append("Document metadata saved to database")
            
        except Exception as e:
            logger.error(f"Failed to create document entry: {e}")
            # Clean up files on database failure
            try:
                if os.path.exists(file_path):
                    os.remove(file_path)
            except Exception as cleanup_e:
                logger.error(f"Failed to clean up file after database error: {cleanup_e}")
            
            return jsonify({'error': 'Failed to save document metadata', 'details': str(e)}), 500
        
        # Success response
        logger.info(f"Document uploaded successfully: ID {document_id}, Path: {file_path}")
        return jsonify({
            'message': 'File uploaded, secured, and processed successfully',
            'results': results
        }), 200
        
    except Exception as e:
        # Catch-all error handler
        logger.error(f"Unexpected error in upload_document: {e}", exc_info=True)
        return jsonify({
            'error': 'Internal server error occurred during file upload',
            'details': 'Please contact administrator if this persists'
        }), 500

@upload_cba_bp.errorhandler(413)
def too_large(e):
    """Handle file too large errors."""
    return jsonify({'error': f'File too large. Maximum size is {MAX_FILE_SIZE/1024/1024}MB'}), 413

@upload_cba_bp.errorhandler(400)
def bad_request(e):
    """Handle bad request errors."""
    return jsonify({'error': 'Bad request - please check your input'}), 400

@upload_cba_bp.route('/documents', methods=['GET'])
def list_documents():

    try:
        include_inactive = request.args.get('include_inactive', 'false').lower() == 'true'
        collections = DocumentLibraryManager.get_all_collections(include_inactive=include_inactive)
        #for each collection, rollup all the contained documents into an object 
        #where the keys are the collection names
        rolled_up_documents = {}
        for collection in collections:
            documents = DocumentLibraryManager.get_documents_by_collection(collection['id'])
            rolled_up_documents[collection['name']] = documents

        return jsonify(rolled_up_documents), 200
        
    except Exception as e:
        print(f"Error fetching documents: {str(e)}")
        return jsonify({'error': 'Internal server error'}), 500